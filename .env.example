# --- Públicas (se incrustan en el bundle del navegador) ---
VITE_SITE_URL=https://btmacademy.com
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
# Pixel de Meta. Sin valor, el pixel no se carga.
VITE_META_PIXEL_ID=

# --- Servidor (secretas) ---
# MongoDB Atlas (cadena de conexión completa, con usuario y contraseña)
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@cluster0.rzenqwo.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=btm_academy

# Panel /admin
ADMIN_PASSWORD=
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Conversions API de Meta. Usa VITE_META_PIXEL_ID si META_PIXEL_ID está vacío.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Opcional: código de "Probar eventos" de Events Manager, solo para pruebas.
META_CAPI_TEST_EVENT_CODE=

# Respaldo de la convocatoria mientras no se guarde nada desde /admin.
WHATSAPP_GROUP_URL=
WHATSAPP_GROUP_LABEL=
# ISO 8601 con desfase, p. ej. 2026-11-15T10:00:00-05:00
EVENT_STARTS_AT=
# Porcentaje que muestra la barra en /procesando (por defecto 79).
FUNNEL_PROGRESS=79
